{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@conneqtcar/types": ["./packages/types/src/index.ts"],
      "@conneqtcar/database": ["./packages/database/src/index.ts"],
      "@conneqtcar/ui": ["./packages/ui/src/index.ts"],
      "@prisma/client": ["./packages/database/src/generated"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}
