# ============================================
# CONNEQTCAR — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env e preencha os valores
# ============================================

# ----- DATABASE -----
DATABASE_URL="postgresql://conneqtcar:conneqtcar@localhost:5432/conneqtcar_dev?schema=public"

# ----- REDIS -----
REDIS_URL="redis://localhost:6379"

# ----- JWT -----
JWT_SECRET="TROQUE_POR_UM_SECRET_FORTE_DE_64_CHARS_EM_PRODUCAO"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="TROQUE_POR_UM_REFRESH_SECRET_FORTE_DE_64_CHARS"
JWT_REFRESH_EXPIRES_IN="30d"

# ----- API -----
API_PORT=3001
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
SELLER_URL="http://localhost:5001"
ADMIN_URL="http://localhost:3002"

# ----- STORAGE (AWS S3) -----
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET="conneqtcar-media-dev"
AWS_CLOUDFRONT_URL="https://your-distribution.cloudfront.net"

# ----- PAGAMENTO (fora do escopo desta fase - não implementado) -----
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# PAGARME_API_KEY="ak_test_..."

# ----- KYC / BIOMETRIA -----
UNICO_CLIENT_ID="your_unico_client_id"
UNICO_CLIENT_SECRET="your_unico_client_secret"

# ----- DETRAN / FIPE -----
FIPE_API_URL="https://parallelum.com.br/fipe/api/v2"
DETRAN_API_URL="https://api.detran.example.com"
DETRAN_API_KEY="your_detran_key"

# ----- NOTIFICAÇÕES -----
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="noreply@conneqtcar.com.br"
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+55..."
FIREBASE_PROJECT_ID="conneqtcar-prod"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@conneqtcar-prod.iam.gserviceaccount.com"

# ----- ASSINATURA DIGITAL -----
D4SIGN_API_URL="https://sandbox.d4sign.com.br/api/v2"
D4SIGN_API_TOKEN="your_token"
D4SIGN_CRYPT_KEY="your_crypt_key"

# ----- LOGS / MONITORING -----
SENTRY_DSN="https://your-key@sentry.io/project-id"
LOG_LEVEL="debug"

# ----- APP -----
NODE_ENV="development"
